# Pinned versions of everything takwerx downloads. `takwerx update` moves them together.
LIMA_VERSION=2.2.0
SOCKET_VMNET_VERSION=1.2.2
SCRCPY_VERSION=4.1
REDROID_IMAGE=docker.io/redroid/redroid:14.0.0_64only-latest
# The GPU runtime (lib/emulator.sh): Google's emulator and system image from
# dl.google.com/android/repository, sha1 as the repository XML states them, and MoltenVK
# from its GitHub release, sha1 of the asset as downloaded 2026-09-26.
EMULATOR_VERSION=37.1.11
EMULATOR_BUILD=15917651
EMULATOR_SHA1=f22f44948a2b7f0a0103645b9a639290eef92426
# Windows: the same build, emulator-windows_x64-$EMULATOR_BUILD.zip, and the x86-64 image
# of the same revision (x86_64-34_r14.zip); sha1 from the repository XML, 2026-09-27.
EMULATOR_WIN_SHA1=54fa750822ff462d57e04fc8e98e60f08df2bb61
SYSIMG_API=34
SYSIMG_TAG=google_apis
SYSIMG_REV=14
SYSIMG_SHA1=2fe8b46d419a3400e30f31b0152b241b50c8b99f
SYSIMG_X86_SHA1=e0f6c9a0691aa27bd597d0deb1bcfdc943ac8ca7
MOLTENVK_VERSION=1.4.2
MOLTENVK_SHA1=44f78183d7a520bca4432b3a76cb8e17c8c1175c
