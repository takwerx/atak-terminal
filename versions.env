# Pinned versions of everything takwerx downloads. `takwerx update` moves them together.
# Every file has a SHA-256 here and is verified before it is unpacked or run; a file that
# does not match is deleted and refused. Where a file comes per Mac architecture, the pin
# carries the suffix _ARM64 or _X86_64.
#
# Lima, socket_vmnet: the SHA256SUMS asset of each GitHub release (Lima's release notes state
# the SHA-256 of that SHA256SUMS file, and it matched), cross-checked against GitHub's own
# asset digest, 2026-10-19.
LIMA_VERSION=2.2.1
LIMA_SHA256_ARM64=9e9eacce88f37e185c346bad73aa6136f738d8cdf8c3bb23cd42b071824bc66e
LIMA_SHA256_X86_64=6b776e4bc41f358e6ee01fefcc78e2eb26f11635a0fcff632234af77a566c6c4
SOCKET_VMNET_VERSION=1.2.2
SOCKET_VMNET_SHA256_ARM64=c7bf62308fbcfdc29bdfb8373c9b1951f7ac2396446e4390919796a94972e6dc
SOCKET_VMNET_SHA256_X86_64=2968a82c97e692c2d36f87230152e8018e00589c1b598e8257775adfe83800a1
# scrcpy: the SHA256SUMS.txt asset of the v5.0.1 release, which matches GitHub's asset digest,
# 2026-10-20.
SCRCPY_VERSION=5.0.1
SCRCPY_SHA256_ARM64=33611e51977a8289e2e124b220f727895181ef2eb9060e0987a4dc2db9cf0d6b
SCRCPY_SHA256_X86_64=31a5467a9e907f162b093267cbbab1276b15c6e709c2ea8159566a8d165beb50
# redroid: the dated tag that 14.0.0_64only-latest pointed at on 2026-10-19 (the same image
# takwerx has pulled since the start), pinned to its manifest-list digest from Docker Hub, so
# podman refuses anything else even if the tag is moved.
REDROID_IMAGE=docker.io/redroid/redroid:14.0.0_64only-240527@sha256:0a611199ba2e0b5d60af39b3327a517f6407231f4352114ed3bd3cbfe2be69aa
# The GPU runtime (lib/emulator.sh): Google's emulator and system image from
# dl.google.com/android/repository, and MoltenVK from its GitHub release. Google's repository
# XML states only SHA-1, so these SHA-256s were taken on 2026-10-19 from files whose SHA-1
# matched the XML (the earlier pins); MoltenVK's matches GitHub's asset digest.
EMULATOR_VERSION=37.1.11
EMULATOR_BUILD=15917651
EMULATOR_SHA256=22530de9363f34ea945ecb5cad74523abd4b615f27f3c1a9899efb183ea9e144
# Windows: the same build, emulator-windows_x64-$EMULATOR_BUILD.zip, and the x86-64 image
# of the same revision.
EMULATOR_WIN_SHA256=5ff441f3b12ace9b13e9cf96fb0007d233967718652a8110705e995ac47bfeb7
# Android 15 (API 35) since 2026-09-27: Android 14's guest graphics leaked one fence file
# descriptor per frame under guest ANGLE, and ATAK hit its 32,768 limit in about ten minutes
# (DECISIONS 2026-09-27). The revision is written as Google names the zip (_r09).
SYSIMG_API=35
SYSIMG_TAG=google_apis
SYSIMG_REV=09
SYSIMG_SHA256=d2e7c6076e5df54d3677605a324daf9edf813b2808c216bdb1687f6b2b6aed99
SYSIMG_X86_SHA256=c67b9ba0ff5bc0eb6d046871bfa228af14d4d47b02f0cdae94f048e511b7566e
# Windows' adb (the Mac uses scrcpy's): platform-tools_r<version>-win.zip, same repository.
PLATFORM_TOOLS_WIN_VERSION=37.0.1
PLATFORM_TOOLS_WIN_SHA256=45f4d63113e895ebde0c90f194099a4676b6ac653bd28d54314a9e022bbc1a99
MOLTENVK_VERSION=1.4.2
MOLTENVK_SHA256=f95765a6229cb7b915990a2890ce12ebe36a730b021545d3d52ae69ce4c4024e
